# Demo UI login (local only). Never enable in production.
VITE_DEMO_MODE=true

# Optional: allow brand tenant preview switcher in the brand shell (demo only).
VITE_ALLOW_DEMO_TENANT_SWITCH=false

# Dedicated Pahachan Supabase project (do not reuse unrelated apps).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Server / Edge Functions only — never expose to the Vite client bundle.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
